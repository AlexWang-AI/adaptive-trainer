# ===== DeepSeek / OpenAI-compatible =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-v4-flash

# 后端从 backend/ 启动时，让它找到仓库根的 .env（改成你的绝对路径）
# DEEPSEEK_ENV_PATH=C:\path\to\mathneuron-teaching-agent\.env

# ===== 后端地址 =====
AGENT_API_URL=http://127.0.0.1:8008

# ===== 可选：LangSmith =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mathneuron
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ===== 前端 =====
# NEXT_PUBLIC_AGENT_API_URL=http://127.0.0.1:8008
