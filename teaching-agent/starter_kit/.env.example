# ===== 真实模型（离线 fake 模式不需要）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== 运行模式 =====
# fake：不联网，用 FakeLLM；real：调真实模型
STARTER_KIT_MODE=fake
# 1：FakeLLM 故意写错第一题答案，用来验证独立答案键
STARTER_KIT_MUTATE=0

# ===== 教学用 token 映射（不是生产认证）=====
STARTER_KIT_TOKENS={"demo-token":"student-1"}
