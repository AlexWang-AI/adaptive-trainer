      "feature": "给出曲线方程或某点，求曲率或曲率半径",
      "steps": [
        "求y'与y''",
        "代入曲率公式K",
        "曲率半径R=1/K",
        "参数方程先求dy/dx、d²y/dx²",
        "在指定点代入计算"
      ],
      "kps": [
        "曲率公式",
        "曲率半径"
      ],
      "source": "method"
    },
    {
      "name": "第三充分条件判极值",
      "feature": "给出f'(x0)=f''(x0)=0及f'''(x0)≠0，问极值",
      "steps": [
        "求f'(x)、f''(x)、f'''(x)",
        "验证f'(x0)=f''(x0)=0且f'''(x0)≠0",
        "由第三充分条件：三阶导非零则x0不是极值点",
        "结论：该点非极值（若最低非零阶为偶数则极值）"
      ],
      "kps": [
        "第三充分条件",
        "极值的必要条件"
      ],
      "source": "method"
    },
    {
      "name": "极值点与拐点对应结论",
      "feature": "已知x0为极值点或拐点，判断另一性质是否成立",
      "steps": [
        "由极值必要条件得f'(x0)=0（可导时）",
        "由拐点必要条件得f''(x0)=0（二阶可导时）",
        "利用结论：极值点处切线水平，拐点处凹凸性改变",
        "结合题设排除或确认，写出结论"
      ],
      "kps": [
        "极值点与拐点的重要结论",
        "拐点的定义"
