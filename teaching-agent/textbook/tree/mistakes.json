{
  "1": {
    "title": "函数极限与连续",
    "items": [
      {
        "kp": "极限四则运算规则",
        "text": "常见易错：分母极限为零时不能直接使用",
        "from": "教材要点"
      },
      {
        "kp": "洛必达法则",
        "text": "易错点：验证条件后再求导，避免循环",
        "from": "教材要点"
      },
      {
        "kp": "泰勒公式",
        "text": "易错点：展开阶数不足导致错误",
        "from": "教材要点"
      },
      {
        "kp": "夹逼准则",
        "text": "易错点：放缩后两端极限需相等",
        "from": "教材要点"
      },
      {
        "kp": "间断点的定义与分类",
        "text": "补『间断点不考虑区间端点，无单侧间断概念』的注意点",
        "from": "教材要点"
      },
      {
        "kp": "泰勒展开阶数速判",
        "text": "风险：分母含根式或复合时阶数估错，需先等价化简",
        "from": "提速层"
      },
      {
        "kp": "加减等价替换规则",
        "text": "风险：直接替换抵消项得0/0错误，如sinx-x不能换x-x",
        "from": "提速层"
      },
      {
        "kp": "幂指函数e化速算",
        "text": "风险：底数趋于0或负时ln无定义，须先判底数正",
        "from": "提速层"
      },
      {
        "kp": "洛必达前先等价化简",
        "text": "风险：加减项替换不合法时化简出错，须验证主部",
        "from": "提速层"
      },
      {
        "kp": "间断点分类速判",
        "text": "风险：分段点处未分别算左右极限，误判可去与跳跃",
        "from": "提速层"
      },
      {
        "kp": "局部保号反推符号",
        "text": "风险：极限为0时不能反推f符号，只能得非负",
        "from": "提速层"
      },
      {
        "kp": "超实数视角看极限（张宇特色）",
        "text": "风险：这是理解工具不是计算工具，考试写解答时仍要用 ε-N/ε-δ 或夹逼，不能写“超实数部分”",
        "from": "提速层"
      }
    ]
  },
  "2": {
    "title": "数列极限",
    "items": [
      {
        "kp": "递推数列压缩映射速判",
        "text": "风险：|f'|≥1 或 f 不压缩时失效，需改用单调有界",
        "from": "提速层"
      },
      {
        "kp": "n项和夹逼取主项",
        "text": "风险：项数随 n 变且主项不唯一时放缩过粗，夹逼失败",
        "from": "提速层"
      },
      {
        "kp": "单调有界三步定序",
        "text": "风险：单调性方向猜错或界不紧时证不出，需换放缩",
        "from": "提速层"
      },
      {
        "kp": "海涅定理反证发散",
        "text": "风险：只找到一种子列收敛不能推出整体收敛",
        "from": "提速层"
      },
      {
        "kp": "收敛速度比阶速判",
        "text": "风险：极限同为 0 时比阶需用等价量，直接比可能 0/0",
        "from": "提速层"
      },
      {
        "kp": "保号性定极限符号",
        "text": "风险：把“≥”误推成“>”，或忽略 N 之后才成立",
        "from": "提速层"
      }
    ]
  },
  "3": {
    "title": "一元函数微分学的概念",
    "items": [
      {
        "kp": "分段点导数左右夹",
        "text": "风险：分界点两侧表达式在x0无定义时定义式要代入f(x0)",
        "from": "提速层"
      },
      {
        "kp": "可导必连续反推陷阱",
        "text": "风险：连续但尖点（如|x|）不可导，别由连续直接写可导",
        "from": "提速层"
      },
      {
        "kp": "导数定义凑增量",
        "text": "风险：f'(x0)不存在时不能拆，须回定义判存在性",
        "from": "提速层"
      },
      {
        "kp": "绝对值可导速判",
        "text": "风险：g'(x0)=0但g变号剧烈（如x^{2/3}型）需回定义验证",
        "from": "提速层"
      },
      {
        "kp": "切线法线斜率速写",
        "text": "风险：竖直切线（导数无穷）要单独讨论，别写-1/k",
        "from": "提速层"
      },
      {
        "kp": "微分近似线性化",
        "text": "风险：Δx较大或f''大时误差大，不能当等式用",
        "from": "提速层"
      },
      {
        "kp": "导数极限定理",
        "text": "风险：前提是 f 在 x0 连续；不连续时 lim f' 存在也不能推可导",
        "from": "提速层"
      }
    ]
  },
  "4": {
    "title": "一元函数微分学的计算",
    "items": [
      {
        "kp": "反函数求导",
        "text": "移到『隐函数求导法/隐函数求导步骤』下作为易错点",
        "from": "教材要点"
      },
      {
        "kp": "隐函数求导法",
        "text": "求 y'' 时对一阶方程再对 x 求导，注意乘积与复合，最后代入点的值",
        "from": "教材要点"
      },
      {
        "kp": "高阶导数",
        "text": "对于不能直接套用常用高阶导数公式的函数，可先恒等变形转化为有公式的形式。",
        "from": "结论"
      },
      {
        "kp": "幂指函数对数求导",
        "text": "风险：u≤0 时取对数无意义，需先加绝对值或改用 e 指数式",
        "from": "提速层"
      },
      {
        "kp": "参数方程二阶导速算",
        "text": "风险：x'(t)=0 处失效；t 为中间变量时勿与 y 对 x 直接求导混淆",
        "from": "提速层"
      },
      {
        "kp": "反函数二阶导公式",
        "text": "风险：y'=0 处反函数不可导；符号漏负是高频错",
        "from": "提速层"
      },
      {
        "kp": "莱布尼茨配高阶导",
        "text": "风险：两因子都非多项式时项数不减少，反而更繁",
        "from": "提速层"
      },
      {
        "kp": "泰勒系数反求高阶导",
        "text": "风险：展开点须为所求点；非解析或展开阶数不够会错",
        "from": "提速层"
      },
      {
        "kp": "分段点导数左右夹",
        "text": "风险：只算一侧或先求导后验连续，易误判可导",
        "from": "提速层"
      }
    ]
  },
  "5": {
    "title": "一元函数微分学的应用（一）几何应用",
    "items": [
      {
        "kp": "铅直渐近线",
        "text": "易错点：只考虑定义域端点或间断点，需逐点验证单侧极限为无穷",
        "from": "教材要点"
      },
      {
        "kp": "水平渐近线",
        "text": "易错点：两个方向的极限可能不同，需分别讨论，最多可有两条水平渐近线",
        "from": "教材要点"
      },
      {
        "kp": "水平渐近线",
        "text": "将该易错点归到渐近线整体或斜渐近线处，并保留例y=sinx/x",
        "from": "教材要点"
      },
      {
        "kp": "斜渐近线",
        "text": "易错点：同一方向水平渐近线与斜渐近线不能并存；x→+∞与x→-∞需分别考察",
        "from": "教材要点"
      },
      {
        "kp": "曲率公式",
        "text": "易错点：二阶导数计算及公式代入",
        "from": "教材要点"
      },
      {
        "kp": "曲率公式",
        "text": "d²y/dx²=(d/dt(y'_x))·(1/x'_t)，不能直接对 y'_x…",
        "from": "教材要点"
      },
      {
        "kp": "二阶导为零拐点速判",
        "text": "风险：f'' 不存在的点易漏，需单独检验两侧符号",
        "from": "提速层"
      },
      {
        "kp": "极值第二充分条件反用",
        "text": "风险：f''=0 时误判为无极值，如 x^4 在 0 点",
        "from": "提速层"
      },
      {
        "kp": "斜渐近线双极限速算",
        "text": "风险：a 不存在或无穷时无斜渐近线，勿硬套",
        "from": "提速层"
      },
      {
        "kp": "曲率公式分子记法",
        "text": "风险：分母指数写成 1/2 或漏绝对值会符号错",
        "from": "提速层"
      },
      {
        "kp": "极值拐点互推结论",
        "text": "风险：把极值点直接当拐点，或忽略 f''' 存在条件",
        "from": "提速层"
      },
      {
        "kp": "开区间最值端点极限补",
        "text": "风险：只比较驻点忽略端点趋势，误判最值存在",
        "from": "提速层"
      }
    ]
  },
  "6": {
    "title": "一元函数微分学的应用（二）中值定理、微分等式与微分不等式",
    "items": [
      {
        "kp": "用中值定理证不等式",
        "text": "注意中值ξ的范围：$a < \\xi < b$，结合$f(a) < f(\\xi) < f(b)$进行放缩",
        "from": "教材要点"
      },
      {
        "kp": "微分不等式",
        "text": "用中值定理证明微分不等式时，注意中值ξ的范围：a < ξ < b，且f(a) < f(ξ) < f(b)。",
        "from": "结论"
      },
      {
        "kp": "双中值拆区间法",
        "text": "风险：分点c选取不当致两式无法合并；需保证c在开区间内",
        "from": "提速层"
      },
      {
        "kp": "罗尔辅助函数构造",
        "text": "风险：g含奇点或积分不可积时失效；端点值需相等",
        "from": "提速层"
      },
      {
        "kp": "泰勒展开阶数速判",
        "text": "风险：展开点选错（应在已知信息最多点）；余项符号判断失误",
        "from": "提速层"
      },
      {
        "kp": "中值定理证不等式方向",
        "text": "风险：f'不单调时放缩方向反；ξ范围取错（应开区间）",
        "from": "提速层"
      },
      {
        "kp": "零点+单调证唯一根",
        "text": "风险：区间端点函数值同号时零点定理失效；需先找异号子区间",
        "from": "提速层"
      },
      {
        "kp": "奇次方程必有实根",
        "text": "风险：仅保证存在不保证个数；偶次方程不适用",
        "from": "提速层"
      }
    ]
  },
  "7": {
    "title": "一元函数微分学的应用（三）物理应用与经济应用",
    "items": [
      {
        "kp": "相关变化率（链式法则应用）",
        "text": "易错点：与微分方程结合的综合题难度较大",
        "from": "教材要点"
      },
      {
        "kp": "相关变化率先定链再代值",
        "text": "风险：在变量取零或关系式退化点代入会除零",
        "from": "提速层"
      },
      {
        "kp": "速度加速度分段看符号",
        "text": "风险：把位移当路程、忽略v变号点会算错",
        "from": "提速层"
      }
    ]
  },
  "8": {
    "title": "一元函数积分学的概念与性质",
    "items": [
      {
        "kp": "敛散性判别法",
        "text": "易错点：判别前需先确认被积函数非负",
        "from": "教材要点"
      },
      {
        "kp": "黎曼和凑积分速配",
        "text": "风险：通项含(-1)^i或非均匀分点会失效",
        "from": "提速层"
      },
      {
        "kp": "变限积分求导链式补",
        "text": "风险：被积函数含x未处理直接套公式必错",
        "from": "提速层"
      },
      {
        "kp": "p积分敛散秒判",
        "text": "风险：积分区间跨瑕点或上下限颠倒时符号/判据错",
        "from": "提速层"
      },
      {
        "kp": "反常积分拆点判敛",
        "text": "风险：直接整体比较会漏判某段发散",
        "from": "提速层"
      },
      {
        "kp": "保号与估值夹逼",
        "text": "风险：区间方向相反或函数变号时不等式翻转",
        "from": "提速层"
      },
      {
        "kp": "原函数存在快判",
        "text": "风险：f仅可积不连续时变限积分未必可导",
        "from": "提速层"
      },
      {
        "kp": "Γ 函数与反常积分的关系",
        "text": "风险：Γ(s) 要求 s>0；指数不是 −x 时先换元凑成标准形",
        "from": "提速层"
      },
      {
        "kp": "反常积分敛散三秒判",
        "text": "风险：被积函数不是纯幂函数时须用比较判别法，不能直接套 p",
        "from": "提速层"
      }
    ]
  },
  "9": {
    "title": "一元函数积分学的计算",
    "items": [
      {
        "kp": "基本积分公式与凑微分",
        "text": "易错：$k=-1$ 不能用幂公式；$\\int a^x\\mathrm{d}x$ 分母是 $\\ln a$ 而非 $a$",
        "from": "结论"
      },
      {
        "kp": "表格积分法",
        "text": "风险：多项式次数高或对数型需先换元，符号易错",
        "from": "提速层"
      },
      {
        "kp": "点火公式速算",
        "text": "风险：区间非[0,π/2]或含奇次幂乘积需先化简",
        "from": "提速层"
      },
      {
        "kp": "变限积分求导链",
        "text": "风险：被积函数含x未剥离直接套公式必错",
        "from": "提速层"
      },
      {
        "kp": "对称周期速判",
        "text": "风险：区间不对称或周期不整时不能直接套",
        "from": "提速层"
      },
      {
        "kp": "三角代换速选",
        "text": "风险：代换后忘换上下限或忘回代原变量",
        "from": "提速层"
      },
      {
        "kp": "部分分式速拆",
        "text": "风险：假分式未先做多项式除法，重根系数漏项",
        "from": "提速层"
      },
      {
        "kp": "区间再现公式",
        "text": "风险：区间不是 [0,a] 对称形式时不能套；换元后上下限要同步对调",
        "from": "提速层"
      },
      {
        "kp": "Γ 函数秒算定积分",
        "text": "风险：a≤0 时发散；n 非整数要用 Γ 函数而非阶乘",
        "from": "提速层"
      },
      {
        "kp": "华里士公式的区间推广",
        "text": "风险：奇次幂在整个周期上积分为 0，别再乘系数",
        "from": "提速层"
      },
      {
        "kp": "积不出的原函数（必须记住）",
        "text": "风险：别把它们当成“没算出来”，这是理论上就积不出；考试常以“是否存在原函数”形式考",
        "from": "提速层"
      },
      {
        "kp": "可积但不可积出",
        "text": "风险：把“积不出”误答成“原函数不存在”",
        "from": "提速层"
      }
    ]
  },
  "10": {
    "title": "一元函数积分学的应用（一）几何应用",
    "items": [
      {
        "kp": "直角坐标下面积（上下函数相减）",
        "text": "易错点：绝对值处理",
        "from": "教材要点"
      },
      {
        "kp": "极坐标下面积",
        "text": "易错点：绝对值保证差值非负",
        "from": "教材要点"
      },
      {
        "kp": "绕 x 轴旋转（圆盘法）",
        "text": "若过L0的垂线与L有多于一个交点，则不能直接套公式10-1",
        "from": "教材要点"
      },
      {
        "kp": "平均值定义",
        "text": "易错点：忽略区间长度或积分上下限",
        "from": "教材要点"
      },
      {
        "kp": "平面曲线弧长",
        "text": "易错点：只需套公式做计算，不用画图",
        "from": "教材要点"
      },
      {
        "kp": "平面曲线弧长",
        "text": "将该易错点移到形心节点下",
        "from": "教材要点"
      },
      {
        "kp": "曲率与曲率半径的积分表达",
        "text": "易错点：答案未必简洁，要多做计算",
        "from": "教材要点"
      },
      {
        "kp": "上下函数面积速写",
        "text": "风险：交点漏解或上下关系判断错会符号反",
        "from": "提速层"
      },
      {
        "kp": "极坐标面积扇形差",
        "text": "风险：θ范围或叶数错会成倍偏差",
        "from": "提速层"
      },
      {
        "kp": "对称性面积减半",
        "text": "风险：区域不对称或函数非奇偶时失效",
        "from": "提速层"
      },
      {
        "kp": "旋转体体积双选法",
        "text": "风险：柱壳半径或高取错、区间分段漏算",
        "from": "提速层"
      },
      {
        "kp": "弧长三公式速记",
        "text": "风险：参数范围或根号内漏项会算错",
        "from": "提速层"
      },
      {
        "kp": "侧面积公式防错",
        "text": "风险：误用圆盘法或漏绝对值会翻车",
        "from": "提速层"
      },
      {
        "kp": "面积/体积的符号陷阱",
        "text": "风险：曲线在 x 轴下方时直接积分得负值，误当面积",
        "from": "提速层"
      }
    ]
  },
  "11": {
    "title": "一元函数积分学的应用（二）积分等式与积分不等式",
    "items": [
      {
        "kp": "用中值定理（积分中值/拉格朗日）",
        "text": "中值点与n有关时不能直接取极限",
        "from": "教材要点"
      },
      {
        "kp": "积分等式的证明",
        "text": "若被积函数含n，则中值ξ_n与n有关，不能直接对中值部分取极限。",
        "from": "结论"
      },
      {
        "kp": "积分中值夹逼定极限",
        "text": "风险：gₙ不变号且峰值位置随n漂移时中值点难控，需改用分段估计",
        "from": "提速层"
      },
      {
        "kp": "分部积分造导数项",
        "text": "风险：g的原函数在端点发散或边界项符号不定时失效",
        "from": "提速层"
      },
      {
        "kp": "柯西积分不等式",
        "text": "风险：f,g需平方可积；等号条件f=kg，非平方可积时不能用",
        "from": "提速层"
      },
      {
        "kp": "泰勒积分余项控阶",
        "text": "风险：f''不存在或界未知时退化为拉格朗日余项，需换点展开",
        "from": "提速层"
      },
      {
        "kp": "换元定号消积分",
        "text": "风险：换元后区间反向忘变号，或奇偶性判断错导致符号翻车",
        "from": "提速层"
      },
      {
        "kp": "拉格朗日差值估计",
        "text": "风险：f不连续或仅可积时中值点ξ不可导，需改用积分中值",
        "from": "提速层"
      }
    ]
  },
  "12": {
    "title": "一元函数积分学的应用（三）物理应用与经济应用",
    "items": [
      {
        "kp": "变力沿直线做功",
        "text": "易错点：积分上下限对应各次击入的深度区间，勿重复累加",
        "from": "教材要点"
      },
      {
        "kp": "抽水做功（微元法）",
        "text": "易错点：抽水路程为x，微元中须乘x而非常数",
        "from": "教材要点"
      },
      {
        "kp": "静水压力",
        "text": "易错点：压强随水深改变，微元须含水深因子x",
        "from": "教材要点"
      },
      {
        "kp": "古鲁金第一定理（旋转体体积/表面积）",
        "text": "易错点：旋转轴与曲线不相交",
        "from": "教材要点"
      },
      {
        "kp": "抽水做功分层速算",
        "text": "风险：水面不在容器顶部或需分段抽水时，提升距离要改，直接套H−x会错",
        "from": "提速层"
      },
      {
        "kp": "静水压力投影法",
        "text": "风险：板倾斜或宽度随深度非单值变化时，w(y)需分段，漏段会少算",
        "from": "提速层"
      },
      {
        "kp": "形心加权平均速算",
        "text": "风险：非均匀密度时须用密度加权，直接套均匀公式会错",
        "from": "提速层"
      },
      {
        "kp": "古鲁金定理反用",
        "text": "风险：旋转轴穿过图形内部或图形与轴相交时，定理不适用",
        "from": "提速层"
      },
      {
        "kp": "变力做功先画力函数",
        "text": "风险：力方向与位移方向不一致时需乘cosθ，直接积分会高估功",
        "from": "提速层"
      },
      {
        "kp": "质心与引力联动",
        "text": "风险：把引力当质心集中处理只在球对称时成立，细杆薄板会翻车",
        "from": "提速层"
      }
    ]
  },
  "13": {
    "title": "多元函数微分学",
    "items": [
      {
        "kp": "偏导数定义与计算",
        "text": "分段/绝对值函数用定义求偏导（易错）",
        "from": "教材要点"
      },
      {
        "kp": "偏导连续速判链",
        "text": "风险：偏导连续只是可微充分条件，不连续仍可能可微，勿反推",
        "from": "提速层"
      },
      {
        "kp": "可微判别三步法",
        "text": "风险：仅偏导存在不能推可微；ρ必须趋于0且与路径无关",
        "from": "提速层"
      },
      {
        "kp": "AC-B²极值快判",
        "text": "风险：=0时失效需定义法；边界点与不可导点不能只用此判别",
        "from": "提速层"
      },
      {
        "kp": "拉格朗日乘数速写",
        "text": "风险：约束退化(∇g=0)时失效；只给驻点，最值还需比较边界",
        "from": "提速层"
      },
      {
        "kp": "方向导数梯度点积",
        "text": "风险：方向向量须单位化；不可微点公式可能失效",
        "from": "提速层"
      },
      {
        "kp": "切平面法线速写",
        "text": "风险：F的梯度为0时曲面可能奇异，需另判；隐式须F可微",
        "from": "提速层"
      },
      {
        "kp": "距离最值的垂线原理",
        "text": "风险：端点也要比较；约束曲线不光滑处（尖点）需单独检查",
        "from": "提速层"
      }
    ]
  },
  "14": {
    "title": "二重积分",
    "items": [
      {
        "kp": "X 型区域（先 y 后 x）",
        "text": "易错点：下限必须小于等于上限，dσ>0",
        "from": "教材要点"
      },
      {
        "kp": "Y 型区域（先 x 后 y）",
        "text": "易错点：交换上下限要添负号",
        "from": "教材要点"
      },
      {
        "kp": "交换积分次序",
        "text": "易错点：反解边界曲线时注意分支（如x=π−arcsin y）",
        "from": "教材要点"
      },
      {
        "kp": "积分限的确定（射线扫描）",
        "text": "易错点：先积 r 后积 θ，内层积分限含 θ，外层为常数",
        "from": "教材要点"
      },
      {
        "kp": "轮换对称性秒杀",
        "text": "风险：区域不关于 y=x 对称时禁用；先验证对称再套",
        "from": "提速层"
      },
      {
        "kp": "奇偶拆分速判",
        "text": "风险：区域不对称或函数非奇非偶时失效",
        "from": "提速层"
      },
      {
        "kp": "换序口诀“画穿定限”",
        "text": "风险：区域分块时须拆成多块，漏块会算错",
        "from": "提速层"
      },
      {
        "kp": "极坐标判据三看",
        "text": "风险：区域非圆类时换极坐标反而更繁；勿漏 r",
        "from": "提速层"
      },
      {
        "kp": "对称性先拆再算",
        "text": "风险：整体判奇偶易错，须逐项判断",
        "from": "提速层"
      },
      {
        "kp": "积分限“外常内变”",
        "text": "风险：内外层限写反或内层出现常数会直接零分",
        "from": "提速层"
      },
      {
        "kp": "二重积分中值定理",
        "text": "风险：要求 f 在闭区域 D 上连续；S_D 不趋零时不能直接取极限",
        "from": "提速层"
      }
    ]
  },
  "15": {
    "title": "常微分方程",
    "items": [
      {
        "kp": "可分离变量方程",
        "text": "易错点：分离变量时可能丢解（奇解）",
        "from": "教材要点"
      },
      {
        "kp": "齐次方程（令 u=y/x）",
        "text": "易错：换元后要把 u 换回 y/x，别停在 u",
        "from": "教材要点"
      },
      {
        "kp": "伯努利方程（仅数一）",
        "text": "易错：n>0 时 y=0 也是解，换元会丢掉，需单独讨论",
        "from": "教材要点"
      },
      {
        "kp": "y''=f(x,y') 型（令 p=y'）",
        "text": "易错点：y''=f(y') 型也按不显含 y 处理",
        "from": "教材要点"
      },
      {
        "kp": "y''=f(y,y') 型（令 p=y'）",
        "text": "易错点：y'' 不能写成 p'",
        "from": "教材要点"
      },
      {
        "kp": "y''=f(y,y') 型（令 p=y'）",
        "text": "易错：这种类型不能令 x 为自变量，必须把 p 看成 y 的函数",
        "from": "教材要点"
      },
      {
        "kp": "一阶线性公式速写",
        "text": "风险：P、Q 前系数须化为 1；∫P dx 不加常数",
        "from": "提速层"
      },
      {
        "kp": "伯努利换元降阶",
        "text": "风险：n=0 或 1 时退化，勿套；注意 y=0 可能是解",
        "from": "提速层"
      },
      {
        "kp": "全微分凑微分速判",
        "text": "风险：P_y≠Q_x 时须先找积分因子，不能直接凑",
        "from": "提速层"
      },
      {
        "kp": "特解形式速写表",
        "text": "风险：右端为多项叠加须拆开分别设；共振时漏乘 x^k",
        "from": "提速层"
      },
      {
        "kp": "欧拉方程换元速化",
        "text": "风险：x<0 时令 x=-e^t；换元后须回代 t=ln|x|",
        "from": "提速层"
      },
      {
        "kp": "降阶 p=y' 分型",
        "text": "风险：两类令法不可混；缺 x 时须把 p 视为 y 的函数",
        "from": "提速层"
      },
      {
        "kp": "微分算子法求特解",
        "text": "风险：F(α)=0 时需乘 x^k（k 为 α 作为特征根的重数），不能直接代",
        "from": "提速层"
      }
    ]
  },
  "16": {
    "title": "无穷级数",
    "items": [
      {
        "kp": "比较判别法（含极限形式）",
        "text": "易错点：前有限项不影响敛散性",
        "from": "教材要点"
      },
      {
        "kp": "收敛半径三秒判",
        "text": "风险：缺项（如只含x²ⁿ）直接套aₙ公式会错，须整体判",
        "from": "提速层"
      },
      {
        "kp": "端点单独判敛",
        "text": "风险：把开区间直接写成闭区间，或漏判端点",
        "from": "提速层"
      },
      {
        "kp": "逐项求导积分保半径",
        "text": "风险：端点处原级数收敛但求导后发散，区间写错",
        "from": "提速层"
      },
      {
        "kp": "间接展开凑标准型",
        "text": "风险：代换后收敛域端点需重新判，勿照搬原区间",
        "from": "提速层"
      },
      {
        "kp": "绝对收敛推收敛",
        "text": "风险：∑|uₙ|发散不能直接说原级数发散，须再判",
        "from": "提速层"
      },
      {
        "kp": "傅里叶和值取中点",
        "text": "风险：端点处误用f(l)或f(-l)，正弦/余弦级数延拓方式不同",
        "from": "提速层"
      },
      {
        "kp": "收敛必要条件不能反用",
        "text": "风险：看到通项趋零就写「收敛」是最高频错",
        "from": "提速层"
      },
      {
        "kp": "阿贝尔定理与端点",
        "text": "风险：把端点直接并入收敛区间会丢分",
        "from": "提速层"
      },
      {
        "kp": "傅里叶级数的狄利克雷条件",
        "text": "风险：忘记取平均，直接用 f(x₀) 会错",
        "from": "提速层"
      },
      {
        "kp": "半区间上的正弦/余弦级数展开",
        "text": "风险：延拓方式决定系数公式；端点值取延拓后的左右平均，不是原函数值",
        "from": "提速层"
      }
    ]
  },
  "17": {
    "title": "多元函数积分学的预备知识（仅数学一）",
    "items": [
      {
        "kp": "空间曲线的切线与法平面",
        "text": "易错点：需验证三个导数不同时为0或雅可比行列式不为0",
        "from": "教材要点"
      },
      {
        "kp": "空间曲线的一般方程与参数方程",
        "text": "在一般式中选某坐标变量为参数解出另两变量得参数式，注意多值或解不出时改用新参数",
        "from": "教材要点"
      },
      {
        "kp": "法向量叉积秒写平面",
        "text": "风险：三点共线或方向向量平行时叉积为零，需先验证",
        "from": "提速层"
      },
      {
        "kp": "直线方向向量速取",
        "text": "风险：两平面平行时无交线，叉积为零需先判位置关系",
        "from": "提速层"
      },
      {
        "kp": "切平面法线速写",
        "text": "风险：隐函数偏导在某点不存在或梯度为零时退化，需单独讨论",
        "from": "提速层"
      },
      {
        "kp": "方向导数梯度点积",
        "text": "风险：方向向量须单位化；grad 为零时各方向导数均为零",
        "from": "提速层"
      },
      {
        "kp": "旋度散度行列式速算",
        "text": "风险：旋度分量符号易错，第二分量带负号；场分量须对应 x,y,z",
        "from": "提速层"
      },
      {
        "kp": "二次曲面配方法识面",
        "text": "风险：含交叉项 xy 等须先正交变换，配方不充分会误判类型",
        "from": "提速层"
      }
    ]
  },
  "18": {
    "title": "多元函数积分学（仅数学一）",
    "items": [
      {
        "kp": "概念与性质",
        "text": "易错点：积分与路径方向有关，反向变号",
        "from": "教材要点"
      },
      {
        "kp": "概念与性质",
        "text": "奇点处P、Q不连续，一阶偏导连续条件被破坏，故不能直接用格林公式",
        "from": "教材要点"
      },
      {
        "kp": "参数方程直接计算",
        "text": "易错点：注意有向性，方向反了要添负号",
        "from": "教材要点"
      },
      {
        "kp": "格林公式（平面）",
        "text": "易错点：L须取正向，反向添负号",
        "from": "教材要点"
      },
      {
        "kp": "直角坐标与极坐标计算",
        "text": "易错点：极坐标下θ的范围要由曲线封闭性确定",
        "from": "教材要点"
      },
      {
        "kp": "先二后一截面法",
        "text": "风险：截面D_z随z变化复杂或分片时易漏段",
        "from": "提速层"
      },
      {
        "kp": "球坐标r·sinφ别漏",
        "text": "风险：φ范围非[0,π]或锥面边界时sinφ符号/范围错",
        "from": "提速层"
      },
      {
        "kp": "补面用高斯",
        "text": "风险：补面方向取反或div计算错导致符号翻车",
        "from": "提速层"
      },
      {
        "kp": "格林补线挖奇点",
        "text": "风险：补线方向与正向不一致或奇点不在区域内仍挖",
        "from": "提速层"
      },
      {
        "kp": "路径无关凑原函数",
        "text": "风险：区域有洞非单连通时路径无关不成立",
        "from": "提速层"
      },
      {
        "kp": "对称性先砍一半",
        "text": "风险：区域不对称或函数奇偶性判断错，尤其含绝对值",
        "from": "提速层"
      },
      {
        "kp": "高斯公式即散度定理",
        "text": "风险：曲面不闭合要先补面，且补的面方向要取外侧（补完再减）",
        "from": "提速层"
      },
      {
        "kp": "斯托克斯与旋度",
        "text": "风险：方向判反直接差一个负号，是这一章最大失分点",
        "from": "提速层"
      },
      {
        "kp": "柱坐标本质是极坐标＋单变量积分",
        "text": "风险：别漏体积元里的 r；z 的上下限随 (r,θ) 变化时要写清",
        "from": "提速层"
      }
    ]
  },
  "19": {
    "title": "第19讲 行列式",
    "items": [
      {
        "kp": "左下三角行列式",
        "text": "按第一列展开，注意代数余子式符号 (-1)^{i+j}",
        "from": "教材要点"
      },
      {
        "kp": "左下三角行列式",
        "text": "易错点：展开时漏掉代数余子式的符号导致结果出错",
        "from": "教材要点"
      },
      {
        "kp": "n阶行列式",
        "text": "1阶行列式规定：|a_{11}|=a_{11}，注意与绝对值区分",
        "from": "教材要点"
      },
      {
        "kp": "余子式",
        "text": "易错点：余子式是行列式，不是矩阵；相对位置不能动顺序",
        "from": "教材要点"
      },
      {
        "kp": "代数余子式",
        "text": "符号规律：(-1)^{i+j}，注意下标从1开始",
        "from": "教材要点"
      },
      {
        "kp": "代数余子式整体赋值法",
        "text": "风险：系数与余子式下标行(列)不对应时翻车",
        "from": "提速层"
      },
      {
        "kp": "余子式与代数余子式符号速判",
        "text": "风险：i+j从1起算，误用0起算会全错号",
        "from": "提速层"
      },
      {
        "kp": "行列式性质一步化三角",
        "text": "风险：只做行变换却混用列变换比例系数会错",
        "from": "提速层"
      },
      {
        "kp": "两行相等/成比例速判为零",
        "text": "风险：近似成比例但差常数项时不能判零",
        "from": "提速层"
      },
      {
        "kp": "拆和行列式分项速算",
        "text": "风险：多行同时为和时须逐行拆，漏拆会少项",
        "from": "提速层"
      },
      {
        "kp": "副对角线行列式符号",
        "text": "风险：n较小时符号易记反，n=2,3需验算",
        "from": "提速层"
      }
    ]
  }
}